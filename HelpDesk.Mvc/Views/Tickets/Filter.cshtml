@model List<HelpDesk.Mvc.Models.Ticket>

@{
    ViewData["Title"] = "Filter Tickets by Status";
}

<div class="container mt-4">
    <h2>Filter Tickets by Status</h2>
    <hr />

    <form asp-action="Filter" method="get" class="mb-4">
        <div class="row g-3">
            <div class="col-md-4">
                <label for="status" class="form-label">Select Status</label>
                <select name="status" id="status" class="form-select" required asp-items="ViewBag.Statuses">
                    <option value="">-- Select Status --</option>
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary me-2">Filter</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Clear</a>
            </div>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(ViewBag.SelectedStatus as string))
    {
        <div class="alert alert-info">
            Showing tickets with status: <strong>@ViewBag.SelectedStatus</strong>
            <span class="badge @GetStatusBadgeClass(ViewBag.SelectedStatus as string) ms-2">@ViewBag.SelectedStatus</span>
        </div>

        <div class="card">
            <div class="card-body">
                @if (Model == null || Model.Count == 0)
                {
                    <div class="text-center py-4">
                        <p class="text-muted">No tickets found with status "@ViewBag.SelectedStatus".</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Title</th>
                                    <th>Category</th>
                                    <th>Priority</th>
                                    <th>Status</th>
                                    <th>Created Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ticket in Model)
                                {
                                    <tr>
                                        <td>@ticket.Id</td>
                                        <td>@ticket.Title</td>
                                        <td>@ticket.Category</td>
                                        <td>
                                            <span class="badge @GetPriorityBadgeClass(ticket.Priority)">
                                                @ticket.Priority
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge @GetStatusBadgeClass(ticket.Status)">
                                                @ticket.Status
                                            </span>
                                        </td>
                                        <td>@ticket.CreatedDate.ToString("MM/dd/yyyy HH:mm")</td>
                                        <td>
                                            <a href="@Url.Action("Details", new { id = ticket.Id })" class="btn btn-sm btn-outline-primary">Details</a>
                                            <a href="@Url.Action("Edit", new { id = ticket.Id })" class="btn btn-sm btn-outline-secondary">Edit</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@functions {
    private string GetPriorityBadgeClass(string priority)
    {
        return priority switch
        {
            "Critical" => "bg-danger",
            "High" => "bg-warning text-dark",
            "Medium" => "bg-info text-dark",
            "Low" => "bg-secondary",
            _ => "bg-light text-dark"
        };
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Open" => "bg-primary",
            "In Progress" => "bg-warning text-dark",
            "Closed" => "bg-success",
            _ => "bg-light text-dark"
        };
    }
}