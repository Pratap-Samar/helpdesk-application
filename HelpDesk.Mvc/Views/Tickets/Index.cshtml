@model List<HelpDesk.Mvc.Models.Ticket>

@{
    ViewData["Title"] = "All Tickets";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between mb-3">
        <h2>All Tickets</h2>
        <a href="@Url.Action("Create")" class="btn btn-primary">Create New</a>
    </div>

    <div class="card">
        <div class="card-body">
            @if (Model == null || Model.Count == 0)
            {
                <div class="text-center py-4">
                    <p class="text-muted">No tickets found.</p>
                    <a href="@Url.Action("Create")" class="btn btn-primary">Create First Ticket</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Created Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ticket in Model)
                            {
                                <tr>
                                    <td>@ticket.Id</td>
                                    <td>@ticket.Title</td>
                                    <td>@ticket.Category</td>
                                    <td>
                                        <span class="badge @GetPriorityBadgeClass(ticket.Priority)">
                                            @ticket.Priority
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(ticket.Status)">
                                            @ticket.Status
                                        </span>
                                    </td>
                                    <td>@ticket.CreatedDate.ToString("MM/dd/yyyy HH:mm")</td>
                                    <td>
                                        <a href="@Url.Action("Details", new { id = ticket.Id })" class="btn btn-sm btn-outline-primary">Details</a>
                                        <a href="@Url.Action("Edit", new { id = ticket.Id })" class="btn btn-sm btn-outline-secondary">Edit</a>
                                        <a href="@Url.Action("Delete", new { id = ticket.Id })" class="btn btn-sm btn-outline-danger">Delete</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <a href="@Url.Action("Filter")" class="btn btn-outline-info">Filter by Status</a>
        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>
</div>

@functions {
    private string GetPriorityBadgeClass(string priority)
    {
        return priority switch
        {
            "Critical" => "bg-danger",
            "High" => "bg-warning text-dark",
            "Medium" => "bg-info text-dark",
            "Low" => "bg-secondary",
            _ => "bg-light text-dark"
        };
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Open" => "bg-primary",
            "In Progress" => "bg-warning text-dark",
            "Closed" => "bg-success",
            _ => "bg-light text-dark"
        };
    }
}